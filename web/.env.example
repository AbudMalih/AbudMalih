# ============================================================
# JARBOU Website – Umgebungsvariablen
# Kopieren nach .env.local (lokal) bzw. im Hosting hinterlegen.
# Niemals Zugangsdaten committen.
# ============================================================

# Öffentliche Basis-URL (Canonical-URLs, Sitemap, Open Graph, JobPosting)
NEXT_PUBLIC_SITE_URL=https://www.jarbou-logistik.com

# --- E-Mail-Versand der Formulare --------------------------------------
# MAIL_DRIVER=smtp  → echter Versand über SMTP
# MAIL_DRIVER=log   → NUR Entwicklung: Ausgabe in der Server-Konsole
#                     (in Produktion automatisch deaktiviert)
# leer              → Formulare melden ehrlich „Versand nicht aktiviert“
MAIL_DRIVER=

SMTP_HOST=
SMTP_PORT=587
# true für Port 465 (SSL), sonst false (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Absender – muss beim SMTP-Anbieter als Absender erlaubt sein (SPF/DKIM)
MAIL_FROM="JARBOU Website <noreply@jarbou-logistik.com>"

# Empfänger
MAIL_TO_CAREERS=karriere@jarbou-logistik.com
# Noch offen – bitte von JARBOU bestätigen:
MAIL_TO_BUSINESS=
MAIL_TO_GENERAL=

# Hinweis zur Löschfrist in jeder Bewerbungs-E-Mail (Tage)
APPLICANT_RETENTION_DAYS=180
