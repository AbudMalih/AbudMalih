# ============================================================
# JARBOU Website – environment variables (placeholders only)
# Copy to .env.local for local work, or enter the values in the
# hosting provider's environment settings for production.
# NEVER commit real credentials. All variables below are
# server-side only – none of them reach the browser.
# ============================================================

# Canonical production URL (canonical tags, sitemap, Open Graph, JobPosting)
NEXT_PUBLIC_SITE_URL=https://www.jarbou-logistik.com

# --- SMTP (one.com) ------------------------------------------
SMTP_HOST=send.one.com
SMTP_PORT=465
# 465 = SSL/TLS → true
SMTP_SECURE=true
# Full mailbox address and its password (set in hosting panel, not here)
SMTP_USER=
SMTP_PASSWORD=
# Sender shown in the notification e-mails. Must be the SMTP_USER mailbox
# or an alias of it (one.com only sends from own addresses).
SMTP_FROM="JARBOU Website <postfach@jarbou-logistik.com>"

# --- Recipients -----------------------------------------------
CAREER_RECIPIENT=karriere@jarbou-logistik.com
# Still to be confirmed by JARBOU – forms answer "not available" until set:
BUSINESS_RECIPIENT=
GENERAL_RECIPIENT=

# --- Applicant data -------------------------------------------
# Retention period in days. Leave EMPTY until the final value is confirmed
# in the Datenschutzerklärung. When set, every application e-mail contains
# the resulting deletion date.
APPLICANT_RETENTION_DAYS=

# --- Development only ------------------------------------------
# MAIL_DRIVER=log writes an HTML preview to the OS temp folder instead of
# sending. Ignored in production.
# MAIL_DRIVER=log
