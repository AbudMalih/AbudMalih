# ============================================================
# Jarbou Logistik – Umgebungsvariablen
# Kopieren Sie diese Datei nach .env.local und tragen Sie
# die echten Werte ein. .env.local wird NICHT committet.
# ============================================================

# --- Formular-Empfänger ---

# Empfänger für B2B-Logistikanfragen (PFLICHT in Produktion)
BUSINESS_INQUIRY_EMAIL=logistik@jarbou-logistik.com

# Empfänger für Bewerbungen (Standard: karriere@jarbou-logistik.com)
CAREER_EMAIL=karriere@jarbou-logistik.com

# --- SMTP-Versand (PFLICHT in Produktion) ---
# Ohne SMTP-Konfiguration werden Formulare im Entwicklungsmodus
# nur in die Server-Konsole geloggt. In Produktion schlagen
# Übermittlungen ohne SMTP-Konfiguration mit Fehler fehl.

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@jarbou-logistik.com
SMTP_PASS=changeme
MAIL_FROM="Jarbou Logistik Website <noreply@jarbou-logistik.com>"
