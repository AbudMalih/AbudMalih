# Copy the NAMES into the hosting panel (Hostinger: Node.js app → Environment variables).
# Never put real values in this file or in git.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@luna-trading.de
SMTP_PASS=
MAIL_FROM=info@luna-trading.de
# 1 = a trusted reverse proxy (Hostinger) sits in front of the app
TRUST_PROXY=1
# optional: extra hosts allowed to submit the forms, e.g. the temporary Hostinger address
ALLOWED_HOSTS=
# "on" ONLY at the approved launch on luna-trading.de (requires a rebuild)
SITE_INDEXING=
