# TURVIO staging – copy to /opt/turvio/.env on the server, then:
#   chmod 600 /opt/turvio/.env      (deploy.sh refuses other permissions)
# Fill in values ON THE SERVER only. Never commit this file with values, never paste them into chat.
# Values with spaces must be quoted.

# --- Public hostnames (DNS A/AAAA records -> the VPS). Placeholders are refused by deploy.sh.
TURVIO_API_HOST=api.staging.example.invalid
TURVIO_DISPATCH_HOST=dispatch.staging.example.invalid
TURVIO_ADMIN_HOST=admin.staging.example.invalid
# E-mail for Let's Encrypt expiry notices.
ACME_EMAIL=ops@example.invalid
# Optional: restrict the Admin app to these client networks (space separated), e.g. "203.0.113.10/32".
# Only after confirming that Caddy logs real client IPs (see runbook, rootless port driver).
ADMIN_ALLOWED_CIDRS="0.0.0.0/0 ::/0"

# --- Supabase project turvio-staging (Frankfurt)
SUPABASE_URL=https://xwryomkbrkwjytwofgcu.supabase.co
# Publishable key (sb_publishable_…) – Dashboard → Project Settings → API Keys
SUPABASE_PUBLISHABLE_KEY=CHANGE_ME
# Secret key (sb_secret_…) – SECRET. Create a dedicated one named "turvio-staging-api".
SUPABASE_SECRET_KEY=CHANGE_ME
# Session pooler (port 5432 – LISTEN/NOTIFY does not work on 6543), role turvio_service.
# URL-encode special characters in the password. No ?sslmode=… – TLS is configured by the
# API (DATABASE_SSL=true + the CA file /opt/turvio/supabase-ca.crt, see the runbook).
DATABASE_URL=postgres://turvio_service.xwryomkbrkwjytwofgcu:CHANGE_ME@aws-1-eu-central-1.pooler.supabase.com:5432/postgres

# --- E-mail (invitations, password reset). EU SMTP provider – required, the API refuses to start without it.
SMTP_URL=smtps://CHANGE_ME:CHANGE_ME@smtp.example.invalid:465
MAIL_FROM="TURVIO Staging <no-reply@example.invalid>"

# --- Optional
# GEOCODER=postgres       # only after importing addresses into geo.addresses
# RATE_LIMIT_PER_MINUTE=600

# --- Deployment (read by deploy.sh, not passed to containers)
# Commits must be reachable from this branch of the Git remote.
DEPLOY_BRANCH=claude/tender-lovelace-4odw0l
