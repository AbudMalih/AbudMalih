# Copy to .env (never commit .env). EXPO_PUBLIC_* values are embedded in the app bundle –
# never put secrets there.

# Base URL of the TURVIO API (apps/api). Leave empty to use the on-device heuristic.
# On a physical phone use your computer's LAN IP, e.g. http://192.168.1.20:4000
EXPO_PUBLIC_API_URL=

# Required only for Android development/production builds with Google Maps.
GOOGLE_MAPS_ANDROID_API_KEY=
