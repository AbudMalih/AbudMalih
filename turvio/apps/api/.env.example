# TURVIO API – copy to apps/api/.env (never commit .env files).
NODE_ENV=development
PORT=4000
OPTIMIZER_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8081

# PostgreSQL. Local: output of `scripts/db.sh url`.
# Supabase: Project Settings → Database → Connection string (URI, role postgres, port 5432 or the
# session pooler). Use the EU (Frankfurt) project. Keep it server-side only.
DATABASE_URL=postgres://turvio_service:turvio-dev-only@localhost:54329/turvio
DATABASE_SSL=false

# Authentication provider:
#   local    – TURVIO stores credentials in Postgres (local dev, CI, self-hosting)
#   supabase – Supabase Auth manages users, sessions and password-reset mails
AUTH_PROVIDER=local
# local: HS256 signing secret, at least 32 random characters (e.g. `openssl rand -base64 48`)
JWT_SECRET=
JWT_ISSUER=turvio-local
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# supabase: Project Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server only – never in a browser or mobile app bundle.
SUPABASE_SERVICE_ROLE_KEY=
# Optional legacy JWT secret; without it tokens are verified via the project's JWKS.
SUPABASE_JWT_SECRET=

# Links in emails
DISPATCH_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# Mail: outbox (development: stored in app_auth.outbox) or smtp (production)
MAILER=outbox
SMTP_URL=
MAIL_FROM=TURVIO <no-reply@your-domain.example>
# Exposes GET /v1/dev/outbox to read development mails. Refused in production.
DEV_MAILBOX=true

# Proof of delivery files (photos, signatures). local = private directory on the API host
# (development / self-hosted with an encrypted volume); supabase = private Storage bucket.
PROOF_STORAGE=local
PROOF_STORAGE_DIR=./.data/proofs
PROOF_BUCKET=proofs

# Address search. none = no provider (addresses are kept and marked "needs map position").
# nominatim / photon = a self-hosted instance (no paid service; the public Nominatim server
# forbids autocomplete and heavy use).
GEOCODER=none
GEOCODER_URL=
GEOCODER_USER_AGENT=TURVIO (your-company.example)

# Hourly retention purge + deletion of removed proof files inside the API process.
BACKGROUND_JOBS=true
