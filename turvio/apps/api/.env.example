# Copy to apps/api/.env for local development. Never commit real values.
NODE_ENV=development
PORT=4000
OPTIMIZER_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8081

# "dev" = synthetic identity without login (development only, refused in production)
# "supabase" = verify Supabase Auth tokens
AUTH_MODE=dev
SUPABASE_URL=
# Optional legacy HS256 secret; if empty, tokens are verified via the project's JWKS
SUPABASE_JWT_SECRET=
# Server-side only. Never expose to browsers or the mobile app.
SUPABASE_SERVICE_ROLE_KEY=
