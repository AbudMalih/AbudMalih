# =============================================================================
# JARBOU Recruiting Command Center – configuration
# Copy this file to ".env" and change the values marked CHANGE.
# NEVER share or commit the .env file – it contains passwords.
# =============================================================================

# --- Web access ---------------------------------------------------------------
# Port on the NAS. Open the application at http://<NAS-IP>:8080
APP_PORT=8080

# --- Database (PostgreSQL, internal only) ------------------------------------
POSTGRES_DB=jarbou_recruiting
POSTGRES_USER=jarbou
# CHANGE: long random password (at least 20 characters). Only the app uses it.
POSTGRES_PASSWORD=CHANGE-ME-to-a-long-random-password

# --- Security -----------------------------------------------------------------
# CHANGE: long random value (at least 32 characters)
APP_SECRET=CHANGE-ME-to-another-long-random-value
# Cookies: auto | true | false.  "true" = only send the login cookie over HTTPS
# (use when everybody accesses via https://…, e.g. Tailscale Serve).
COOKIE_SECURE=auto
# Set to true ONLY when running behind a reverse proxy / Tailscale Serve on the NAS.
TRUST_PROXY=false
# Sign-out after this many minutes without activity
SESSION_IDLE_MINUTES=480
# Maximum session length without "Stay signed in" (hours) / with it (days)
SESSION_MAX_HOURS=12
SESSION_REMEMBER_DAYS=14
PASSWORD_MIN_LENGTH=10

# --- First administrator (used ONLY when no user exists yet) ----------------
# The password must be changed at the first sign-in. Remove it from this file afterwards.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_FULL_NAME=Administrator
INITIAL_ADMIN_EMAIL=
# CHANGE: temporary password (min. 10 characters, letters and numbers, must NOT contain the username)
INITIAL_ADMIN_PASSWORD=

# --- Time zone ------------------------------------------------------------------
TZ=Europe/Berlin

# --- Backups (stored in ./backups on the NAS) ----------------------------------
BACKUP_ENABLED=true
# Daily automatic backup time (24h, NAS time zone)
BACKUP_TIME=02:30
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=3

# --- Document uploads ------------------------------------------------------------
UPLOADS_ENABLED=true
UPLOAD_MAX_MB=15

# --- Optional: Tailscale private HTTPS access (docker-compose.tailscale.yml) ------
# Auth key from https://login.tailscale.com/admin/settings/keys (reusable: no, pre-approved: yes)
TS_AUTHKEY=
TS_HOSTNAME=jarbou-recruiting
# When everybody uses the https://…ts.net address, also set:  COOKIE_SECURE=true  and  TRUST_PROXY=true
